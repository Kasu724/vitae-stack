# Copy to an access-restricted .env.production outside version control.
# Copy the exact tag@sha256 records from the verified release image manifests.
VITAE_APP_IMAGE=ghcr.io/replace/vitae-stack-app:0.1.0@sha256:replace
VITAE_PARSER_IMAGE=ghcr.io/replace/vitae-stack-parser:0.1.0@sha256:replace
VITAE_JOB_FETCHER_IMAGE=ghcr.io/replace/vitae-stack-job-fetcher:0.1.0@sha256:replace
VITAE_DELETION_WORKER_IMAGE=ghcr.io/replace/vitae-stack-deletion-worker:0.1.0@sha256:replace
VITAE_TOOLS_IMAGE=ghcr.io/replace/vitae-stack-tools:0.1.0@sha256:replace

POSTGRES_ADMIN_PASSWORD=replace-with-random-admin-password
VITAE_OWNER_PASSWORD=replace-with-random-migration-role-password
VITAE_APP_PASSWORD=replace-with-random-runtime-role-password
# URL-encode reserved characters in the two passwords below.
VITAE_DATABASE_URL=postgresql://vitae_app:replace-with-url-encoded-runtime-password@postgres:5432/vitae
VITAE_MIGRATION_DATABASE_URL=postgresql://vitae_owner:replace-with-url-encoded-owner-password@postgres:5432/vitae

APP_BASE_URL=https://vitae.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
# Base64-encoded 32-byte key; retain old keys during an explicit rotation.
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
CREDENTIAL_KEY_VERSION=1
