{
  "name": "vitae-stack",
  "version": "0.0.0",
  "private": true,
  "description": "Privacy-first, evidence-grounded resume and cover-letter tailoring platform",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:contract": "vitest run tests/contract --passWithNoTests",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/a11y",
    "test:smoke": "playwright test tests/smoke",
    "test:parsers": "vitest run tests/parsers --passWithNoTests",
    "test:security": "vitest run tests/security --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check": "drizzle-kit check && vitest run tests/database",
    "auth:bootstrap": "tsx scripts/auth-bootstrap.ts",
    "auth:reset-password": "tsx scripts/auth-reset-password.ts",
    "auth:claim-trusted-local": "tsx scripts/auth-claim-trusted-local.ts",
    "auth:benchmark": "tsx scripts/auth-benchmark.ts",
    "parser:worker": "tsx scripts/parser-worker.ts",
    "docs:check": "node scripts/docs-check.mjs",
    "security:check": "node scripts/security-check.mjs && corepack pnpm audit --audit-level high --prod"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.22",
    "better-auth": "1.6.22",
    "drizzle-orm": "0.45.2",
    "file-type": "22.0.1",
    "mammoth": "1.12.0",
    "next": "16.2.9",
    "pdfjs-dist": "6.1.200",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.1",
    "@testcontainers/postgresql": "12.0.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.0.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react": "6.0.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "jsdom": "29.1.1",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.1",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
