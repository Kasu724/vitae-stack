{
  "name": "vitae-stack",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first, evidence-grounded resume and cover-letter tailoring platform",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:contract": "vitest run tests/contract --passWithNoTests",
    "test:e2e": "playwright test tests/e2e",
    "test:smoke": "playwright test tests/smoke",
    "test:parsers": "vitest run tests/parsers --passWithNoTests",
    "test:security": "vitest run tests/security --passWithNoTests",
    "test:ssrf": "vitest run tests/security/url-fetching.security.test.ts",
    "test:ats": "vitest run tests/ats --passWithNoTests",
    "test:exports": "vitest run tests/exports --passWithNoTests",
    "test:portability": "vitest run tests/portability --passWithNoTests",
    "test:deletion": "vitest run tests/deletion --passWithNoTests",
    "test:load": "tsx scripts/load-smoke.ts",
    "test:performance": "tsx scripts/performance-domain-smoke.ts",
    "test:personal": "playwright test tests/personal",
    "test:evals": "tsx scripts/run-evals.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check": "node scripts/sqlite-schema-check.mjs && vitest run tests/database",
    "db:seed:synthetic": "tsx scripts/seed-synthetic.ts",
    "db:seed:performance": "tsx scripts/seed-performance.ts",
    "notices:generate": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "docs:check": "node scripts/docs-check.mjs",
    "security:check": "node scripts/security-check.mjs && corepack pnpm audit --audit-level high --prod"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.1",
    "@next/env": "16.2.9",
    "@swc/helpers": "0.5.15",
    "baseline-browser-mapping": "2.10.40",
    "busboy": "1.6.0",
    "caniuse-lite": "1.0.30001799",
    "docx": "9.7.1",
    "file-type": "22.0.1",
    "htmlparser2": "12.0.0",
    "mammoth": "1.12.0",
    "next": "16.2.9",
    "pdfjs-dist": "6.1.200",
    "pdfkit": "0.19.1",
    "postcss": "8.5.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "styled-jsx": "5.1.6",
    "tsx": "4.22.4",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.2.9",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.1",
    "@types/busboy": "1.5.4",
    "@types/node": "26.0.1",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.0.3",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "29.1.1",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.1",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.9"
  }
}
