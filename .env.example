# M01–M04 read runtime, database, and authentication values below. Later
# milestones activate the documented storage, AI, worker, and ingestion settings.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APP_BIND_HOST=127.0.0.1

# Use password in shared/remote environments. trusted-local must bind loopback.
AUTH_MODE=password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
REGISTRATION_MODE=closed
# Bootstrap the first account with hidden input:
# pnpm auth:bootstrap -- --email owner@example.test --name "Owner"
# For a mounted secret, set AUTH_BOOTSTRAP_PASSWORD_FILE only for that process.
# TRUSTED_LOCAL_DANGER_ACK=false

DATABASE_URL=postgresql://vitae_app:replace-me@127.0.0.1:5432/vitae
DATABASE_MIGRATION_URL=postgresql://vitae_owner:replace-me@127.0.0.1:5432/vitae

ARTIFACT_STORAGE_DRIVER=filesystem
ARTIFACT_STORAGE_ROOT=./var/private/artifacts
PARSER_QUEUE_ROOT=./var/private/parser-queue
JOB_FETCH_QUEUE_ROOT=./var/private/job-fetch-queue
PARSER_MODE=inline
JOB_FETCH_MODE=inline
# CREDENTIAL_ENCRYPTION_KEY must be a base64-encoded 32-byte key before storing provider credentials.
# CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=1
# Exact private/local origins permitted for model calls, comma separated.
# AI_PRIVATE_ENDPOINT_ALLOWLIST=http://127.0.0.1:11434,http://ollama:11434
PARSER_TIMEOUT_MS=15000
PARSER_MAX_TEXT_CHARS=500000
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=120
UPLOAD_MAX_BYTES=10485760
URL_FETCH_MAX_BYTES=5242880
URL_FETCH_TIMEOUT_MS=10000
LOG_LEVEL=info
TELEMETRY_ENABLED=false
