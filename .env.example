# Local development defaults. The downloadable build creates these values
# automatically; users do not need to edit this file.
NODE_ENV=development
APP_BASE_URL=http://127.0.0.1:3000
APP_BIND_HOST=127.0.0.1

# One ordinary SQLite file plus one folder for uploaded/generated files.
DATABASE_PATH=./var/vitae.sqlite
ARTIFACT_STORAGE_ROOT=./var/files
PARSER_QUEUE_ROOT=./var/runtime/parser-queue
JOB_FETCH_QUEUE_ROOT=./var/runtime/job-fetch-queue

PARSER_MODE=inline
JOB_FETCH_MODE=inline
PARSER_TIMEOUT_MS=15000
PARSER_MAX_TEXT_CHARS=500000
UPLOAD_MAX_BYTES=10485760

# Optional AI-provider credentials are encrypted locally. The personal launcher
# generates this key automatically. For source development, use a base64-encoded
# random 32-byte value before saving any provider credential.
# CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=1

# Exact local/private model endpoints allowed for model calls, comma-separated.
# AI_PRIVATE_ENDPOINT_ALLOWLIST=http://127.0.0.1:11434
TELEMETRY_ENABLED=false
